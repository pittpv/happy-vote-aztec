{
  "name": "happy-vote-aztec",
  "version": "0.1.0",
  "main": "index.js",
  "author": "HappyVote",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "fees": "NODE_NO_WARNINGS=1 tsx scripts/fees.ts",
    "clean": "rm -rf ./src/artifacts ./target ./codegenCache.json",
    "clear-store": "rm -rf ./store",
    "codegen": "aztec codegen target --outdir src/artifacts",
    "compile": "aztec compile",
    "compile:codegen": "aztec compile && aztec codegen target --outdir src/artifacts",
    "deploy": "NODE_NO_WARNINGS=1 tsx scripts/deploy_contract.ts",
    "deploy:testnet": "NODE_NO_WARNINGS=1 tsx scripts/deploy_testnet.ts",
    "smoke": "NODE_NO_WARNINGS=1 tsx scripts/smoke_local.ts",
    "create-poll": "NODE_NO_WARNINGS=1 tsx scripts/create_poll.ts",
    "deploy-account": "NODE_NO_WARNINGS=1 tsx scripts/deploy_account.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "yarn test:nr",
    "test:js": "rm -rf store/pxe && NODE_NO_WARNINGS=1 node --experimental-vm-modules $(yarn bin jest) --no-cache --runInBand --config jest.integration.config.json",
    "test:nr": "aztec test"
  },
  "dependencies": {
    "@aztec/accounts": "5.1.0",
    "@aztec/aztec.js": "5.1.0",
    "@aztec/constants": "5.1.0",
    "@aztec/entrypoints": "5.1.0",
    "@aztec/noir-contracts.js": "5.1.0",
    "@aztec/protocol-contracts": "5.1.0",
    "@aztec/pxe": "5.1.0",
    "@aztec/stdlib": "5.1.0",
    "@aztec/wallet-sdk": "5.1.0",
    "@aztec/wallets": "5.1.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.15.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.4.4"
  },
  "jest": {
    "testTimeout": 200000
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

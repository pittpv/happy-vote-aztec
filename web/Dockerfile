FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY . .

ARG VITE_AZTEC_NODE_URL=https://aztec-testnet.drpc.org
ARG VITE_HAPPY_VOTE_CONTRACT_ADDRESS=0x256692c1a2f24fe72c4351db82a72d0591225c132886c190d03a0069151f9f78
ARG VITE_HIDDEN_AUTHOR_BOOK_ADDRESS=0x0db4e58ff03bd09d758c4e3aee0fb042b21e61aa410aad2f6a0b8f7537fefeec
ARG VITE_SEALED_TALLY_BOOK_ADDRESS=0x11b4482fff1547eed30cb860cd9e017e1b84890539641ab3831d9c98b35d3b3d
ARG VITE_SPONSORED_FPC_ADDRESS=0x2d8fff82a3b0c15d0a89169e7d8d043e079ab94d52031f1de1e4972ebad169d3
ARG VITE_DEFAULT_POLL_ID=1
ARG VITE_PROVER_ENABLED=true
ARG VITE_REQUIRE_ZKPASSPORT=false
ARG VITE_ZKPASSPORT_ENABLED=true
ARG VITE_ZKPASSPORT_DOMAIN=aztec.happyvote.xyz
ARG VITE_ZKPASSPORT_DEFAULT_POLICY=vote-identity-verification
ARG VITE_ZKPASSPORT_DEV_MODE=false

ENV VITE_AZTEC_NODE_URL=$VITE_AZTEC_NODE_URL \
    VITE_HAPPY_VOTE_CONTRACT_ADDRESS=$VITE_HAPPY_VOTE_CONTRACT_ADDRESS \
    VITE_HIDDEN_AUTHOR_BOOK_ADDRESS=$VITE_HIDDEN_AUTHOR_BOOK_ADDRESS \
    VITE_SEALED_TALLY_BOOK_ADDRESS=$VITE_SEALED_TALLY_BOOK_ADDRESS \
    VITE_SPONSORED_FPC_ADDRESS=$VITE_SPONSORED_FPC_ADDRESS \
    VITE_DEFAULT_POLL_ID=$VITE_DEFAULT_POLL_ID \
    VITE_PROVER_ENABLED=$VITE_PROVER_ENABLED \
    VITE_REQUIRE_ZKPASSPORT=$VITE_REQUIRE_ZKPASSPORT \
    VITE_ZKPASSPORT_ENABLED=$VITE_ZKPASSPORT_ENABLED \
    VITE_ZKPASSPORT_DOMAIN=$VITE_ZKPASSPORT_DOMAIN \
    VITE_ZKPASSPORT_DEFAULT_POLICY=$VITE_ZKPASSPORT_DEFAULT_POLICY \
    VITE_ZKPASSPORT_DEV_MODE=$VITE_ZKPASSPORT_DEV_MODE

RUN npm ci && npm run build \
  && sed -i 's/\r$//' /app/docker-entrypoint.sh \
  && groupadd --system --gid 10001 happyvote \
  && useradd --system --uid 10001 --gid happyvote --home /tmp --shell /usr/sbin/nologin happyvote \
  && chmod 755 /app/docker-entrypoint.sh

ENV NODE_ENV=production
ENV PORT=4188
ENV HOST=0.0.0.0
ENV HOME=/tmp

EXPOSE 4188

ENTRYPOINT ["/app/docker-entrypoint.sh"]

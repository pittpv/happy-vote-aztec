VITE_AZTEC_NODE_URL=https://aztec-testnet.drpc.org
VITE_HAPPY_VOTE_CONTRACT_ADDRESS=
VITE_SPONSORED_FPC_ADDRESS=0x2d8fff82a3b0c15d0a89169e7d8d043e079ab94d52031f1de1e4972ebad169d3
# Optional. HiddenAuthorBook address. Private author stays off until this is set.
# Deploy HappyVote with the book gate, deploy HiddenAuthorBook, then set the book on HappyVote.
VITE_HIDDEN_AUTHOR_BOOK_ADDRESS=
# Optional. SealedTallyBook address. Sealed ballots stay off until this is set.
VITE_SEALED_TALLY_BOOK_ADDRESS=
# Optional. When set, private-author create and end pay through this contract instead of the canonical Sponsored FPC.
# Required on Mainnet. Testnet uses the canonical Sponsored FPC when this is empty.
VITE_AUTHOR_FEE_SPONSOR_ADDRESS=
VITE_DEFAULT_POLL_ID=1
VITE_PROVER_ENABLED=true
VITE_REQUIRE_ZKPASSPORT=false
VITE_ZKPASSPORT_ENABLED=true
VITE_ZKPASSPORT_DOMAIN=aztec.happyvote.xyz
VITE_ZKPASSPORT_DEV_MODE=false
VITE_ZKPASSPORT_DEFAULT_POLICY=vote-identity-verification
